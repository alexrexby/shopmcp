# Store config generated by `shopmcp scaffold`. Edit every line marked EDIT.
# Конфиг магазина, созданный `shopmcp scaffold`. Отредактируйте строки с пометкой EDIT.
#
# Secrets never go inline: write `$${VAR}` and set VAR in the environment.
# Секреты не пишутся в файл: укажите `$${VAR}` и задайте VAR в окружении.

id = $id
prefix = $prefix                    # tool name prefix: <prefix>_products_search / префикс инструментов
brand = $brand                      # EDIT: store name the model sees / название магазина для модели
site = $site
locale = $locale                    # ru | en: language of every model-facing text / язык текстов для модели
# EDIT: what the store sells, prices, regions; shown to the model as server instructions.
# EDIT: что продаёт магазин, цены, регионы; модель видит это как instructions сервера.
instructions = """"""
# phone = "+7 000 000-00-00"
# delivery = ""
# payment = ""
# regions = []

$engine
[adapter]
$adapter

[cart]
# link_list | url_template | json_fragment | form_post | receiver | share_link.
# link_list works for any store: links to product pages.
# link_list работает в любом магазине: ссылки на карточки товаров.
$cart

[limits]
max_page_size = 20
max_cart_lines = 30
max_quantity = 99                   # per cart line / на одну позицию корзины
max_response_bytes = 24000
rate_per_minute = 60

[server]
path = "/mcp"
host = "0.0.0.0"
port = 8000
# EDIT: public URL of the endpoint; the RFC 9728 resource and the token audience.
# EDIT: публичный URL эндпоинта; resource в RFC 9728 и aud токена.
public_url = "http://localhost:8000/mcp"
# Behind a reverse proxy add the public host here, e.g. "mcp.shop.example".
# За реверс-прокси добавьте сюда публичный хост, например "mcp.shop.example".
allowed_hosts = ["localhost:*", "127.0.0.1:*"]
# Browser clients only: listed origins also get CORS. / Только для браузерных клиентов: этим origin включается CORS.
allowed_origins = []
trusted_proxies = []                # whose X-Forwarded-For to trust / чьему X-Forwarded-For верить

[auth]
enabled = false
issuer = ""
jwks_uri = ""
[auth.tool_scopes]
orders_history = ["orders.read"]    # key = tool suffix / ключ = суффикс инструмента

[tools]
disabled = []                       # suffixes to hide / суффиксы, которые скрыть

[texts]
# Override any model-facing text by key, in the store language ($locale_name), e.g.:
# Переопределение любого текста для модели по ключу, на языке магазина ($locale_name), например:
# "tool.products_search.description" = "..."

[conformance]
sample_query = $sample_query        # EDIT: must find >= 1 product / обязан найти >= 1 товар
# sample_barcode = "4600000000017"
